#!/usr/bin/env bash
set -eu

worker=$(( ${TEST_ENV_NUMBER:-1} - 1 ))
export KNAPSACK_CI_NODE_INDEX=$((worker + PARALLEL_TESTS_CONCURRENCY * KNAPSACK_CI_NODE_INDEX))
export KNAPSACK_CI_NODE_TOTAL=$((PARALLEL_TESTS_CONCURRENCY * KNAPSACK_CI_NODE_TOTAL))
export CI_NODE_INDEX="$KNAPSACK_CI_NODE_INDEX" CI_NODE_TOTAL="$KNAPSACK_CI_NODE_TOTAL"
echo "Running test shard $((CI_NODE_INDEX + 1)) of $CI_NODE_TOTAL"
exec bundle exec rails knapsack:rspec
