#!/usr/bin/env sh
set -eu
port="${PORT:-${RAILS_PORT:-3000}}"
deadline=$(( $(date +%s) + 180 ))
until curl -fsS --max-time 3 "http://127.0.0.1:$port/api/v1/status" >/dev/null 2>&1; do
  if [ "$(date +%s)" -ge "$deadline" ]; then
    echo "Timed out waiting for /api/v1/status on port $port" >&2
    exit 1
  fi
  sleep 2
done
