#!/usr/bin/env ruby
require 'fileutils'
require_relative 'bundler'

Dir.chdir(File.expand_path('..', __dir__)) do
  FileUtils.cp('.env.sample', '.env') unless File.exist?('.env')
  version = lockfile_version
  unless system('gem', 'list', '--installed', '--exact', 'bundler', '--version', version, out: File::NULL)
    system('gem', 'install', 'bundler', '--version', version, exception: true)
  end
  system('bin/bundle', 'check') || system('bin/bundle', 'install', exception: true)
  system('yarn', 'install', '--immutable', exception: true)
  system('yarn', 'build', exception: true)
  system('bin/rails', 'db:prepare', 'tailwindcss:build', 'tailwindcss:build_users', exception: true)
  exec 'bin/dev' unless ARGV.include?('--skip-server')
end
