#!/usr/bin/env bash
set -euo pipefail

if [[ "${RAILS_ENV:-}" == test || "${1:-}" == ./bin/rspec ]]; then
  ./bin/rails db:prepare
  if [[ "${1:-}" == ./bin/rspec ]]; then
    ./bin/rails assets:precompile
  fi
elif [[ "${1:-}" == ./bin/dev || "${1:-} ${2:-}" == './bin/rails server' || "${1:-} ${2:-} ${3:-}" == 'bundle exec puma' ]]; then
  ./bin/rails db:prepare
fi

exec "$@"
