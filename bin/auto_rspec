#!/usr/bin/env ruby
# Run specs for changed Ruby files and any additional filename patterns.
require 'open3'

def git_paths(*args)
  output, status = Open3.capture2('git', *args)
  abort 'Unable to read the Git working tree' unless status.success?
  output.split("\0")
end

changed = git_paths('diff', '--diff-filter=d', '--name-only', '-z', 'HEAD') +
          git_paths('ls-files', '--others', '--exclude-standard', '-z')
filenames = changed.grep(/\.rb\z/).map do |path|
  name = File.basename(path, '.rb')
  "#{name.delete_suffix('_spec')}_spec.rb"
end

specs = Dir['spec/**/*_spec.rb'].select do |path|
  name = File.basename(path)
  filenames.include?(name) || ARGV.any? { |term| File.fnmatch?("*#{term}*_spec.rb", name) }
end

abort "No matching specs. Usage: #{$PROGRAM_NAME} [filename patterns]" if specs.empty?
exec 'bundle', 'exec', 'rspec', *specs
