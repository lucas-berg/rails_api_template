#!/usr/bin/env ruby
require_relative 'helpers'

remove_containers = %w[--rm --remove-containers -rm].any? { |flag| ARGV.delete(flag) }
if running_with_docker?
  compose = %w[docker compose -f docker-compose.test.yml]
  success = system(*compose, 'run', '--build', '--rm', 'web', './bin/rspec', *ARGV)
  system(*compose, 'down', exception: true) if remove_containers
  exit(success ? 0 : 1)
end

require 'bundler/setup'
load Gem.bin_path('rspec-core', 'rspec')
