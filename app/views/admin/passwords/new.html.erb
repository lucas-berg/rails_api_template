<% content_for :title, 'Reset password' %>
<h1>Reset your password</h1><p class="admin-auth__lead">Enter your administrator email to request a reset link.</p>
<%= render 'admin/shared/errors', resource: resource %>
<%= form_with model: resource, as: resource_name, url: admin_user_password_path, local: true, class: 'admin-form' do |form| %>
  <div><%= form.label :email %><%= form.email_field :email, autofocus: true, autocomplete: 'email', required: true %></div>
  <%= form.submit 'Send reset link', class: 'admin-button' %>
<% end %>
<p class="admin-auth__footer"><%= link_to 'Back to sign in', new_admin_user_session_path %></p>
