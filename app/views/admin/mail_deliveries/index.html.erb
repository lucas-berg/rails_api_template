<% content_for :title, 'Mail deliveries' %>
<header class="admin-heading"><div><span class="admin-eyebrow">Workspace operations</span><h1>Mail deliveries</h1><p>Review transactional mail and recover failed deliveries.</p></div></header>
<%= search_form_for @search, url: admin_mail_deliveries_path, html: { class: "admin-filters" } do |form| %>
  <div><%= form.label :status_eq, "Status" %><%= form.select :status_eq, %w[pending sending sent failed skipped], include_blank: "All" %></div>
  <div><%= form.label :kind_eq, "Kind" %><%= form.select :kind_eq, %w[devise invitation], include_blank: "All" %></div>
  <div><%= form.label :team_id_eq, "Team id" %><%= form.number_field :team_id_eq, min: 1 %></div>
  <div><%= form.label :user_id_eq, "User id" %><%= form.number_field :user_id_eq, min: 1 %></div>
  <div><%= label_tag :per_page, "Per page" %><%= select_tag :per_page, options_for_select([20, 50, 100], @per_page) %></div>
  <%= form.submit "Search", class: "admin-button" %><%= link_to "Clear", admin_mail_deliveries_path, class: "admin-text-link" %>
<% end %>
<section class="admin-panel"><% if @mail_deliveries.any? %><div class="admin-table-wrap"><table><caption class="admin-sr-only">Mail deliveries</caption><thead><tr><th scope="col">ID</th><th scope="col">Kind</th><th scope="col">Status</th><th scope="col">Attempts</th><th scope="col">Next attempt at</th></tr></thead><tbody>
<% @mail_deliveries.each do |record| %><tr><td><%= link_to record.id, admin_mail_delivery_path(record) %></td><td><%= record.kind.presence || "—" %></td><td><%= admin_status(record.status) %></td><td><%= record.attempts.presence || "—" %></td><td><%= admin_time(record.next_attempt_at) %></td></tr><% end %>
</tbody></table></div><% else %><div class="admin-empty"><h2>No matching records</h2><p>Try changing the filters or come back after new activity.</p></div><% end %></section>
<%= render "admin/shared/pagination", page: @page, per_page: @per_page, total: @total, filters: @filters %>
