<div class="admin-pagination">
  <span><%= number_with_delimiter(total) %> records · Page <%= page %></span>
  <nav aria-label="Pagination">
    <% if page > 1 %><%= link_to '← Previous', admin_page_path(page - 1, filters:, per_page:), class: 'admin-button admin-button--secondary' %><% end %>
    <% if page * per_page < total %><%= link_to 'Next →', admin_page_path(page + 1, filters:, per_page:), class: 'admin-button admin-button--secondary' %><% end %>
  </nav>
</div>
