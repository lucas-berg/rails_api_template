<% content_for :title, 'Members' %>
<header class="admin-heading"><div><span class="admin-eyebrow">Workspace operations</span><h1>Members</h1><p>Inspect membership and role assignments.</p></div></header>
<%= search_form_for @search, url: admin_members_path, html: { class: "admin-filters" } do |form| %>
  <div><%= form.label :team_id_eq, "Team id" %><%= form.number_field :team_id_eq, min: 1 %></div>
  <div><%= form.label :user_id_eq, "User id" %><%= form.number_field :user_id_eq, min: 1 %></div>
  <div><%= form.label :role_eq, "Role" %><%= form.select :role_eq, %w[owner admin member viewer], include_blank: "All" %></div>
  <div><%= form.label :status_eq, "Status" %><%= form.select :status_eq, %w[active removed], include_blank: "All" %></div>
  <div><%= label_tag :per_page, "Per page" %><%= select_tag :per_page, options_for_select([20, 50, 100], @per_page) %></div>
  <%= form.submit "Search", class: "admin-button" %><%= link_to "Clear", admin_members_path, class: "admin-text-link" %>
<% end %>
<section class="admin-panel"><% if @members.any? %><div class="admin-table-wrap"><table><caption class="admin-sr-only">Members</caption><thead><tr><th scope="col">ID</th><th scope="col">Team id</th><th scope="col">User id</th><th scope="col">Role</th><th scope="col">Status</th></tr></thead><tbody>
<% @members.each do |record| %><tr><td><%= link_to record.id, admin_member_path(record) %></td><td><%= record.team_id.presence || "—" %></td><td><%= record.user_id.presence || "—" %></td><td><%= admin_status(record.role) %></td><td><%= admin_status(record.status) %></td></tr><% end %>
</tbody></table></div><% else %><div class="admin-empty"><h2>No matching records</h2><p>Try changing the filters or come back after new activity.</p></div><% end %></section>
<%= render "admin/shared/pagination", page: @page, per_page: @per_page, total: @total, filters: @filters %>
