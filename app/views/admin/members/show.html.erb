<% content_for :title, "Member ##{@member.id}" %>
<%= link_to '← Members', admin_members_path, class: 'admin-back' %>
<header class="admin-heading"><div><span class="admin-eyebrow">Record details</span><h1>Member #<%= @member.id %></h1></div></header>
<section class="admin-panel admin-detail-panel"><dl class="admin-details">
  <div><dt>ID</dt><dd><%= @member.id.presence || "—" %></dd></div>
  <div><dt>Team id</dt><dd><%= @member.team_id.presence || "—" %></dd></div>
  <div><dt>User id</dt><dd><%= @member.user_id.presence || "—" %></dd></div>
  <div><dt>Role</dt><dd><%= admin_status(@member.role) %></dd></div>
  <div><dt>Status</dt><dd><%= admin_status(@member.status) %></dd></div>
  <div><dt>Created at</dt><dd><%= admin_time(@member.created_at) %></dd></div>
  <div><dt>Updated at</dt><dd><%= admin_time(@member.updated_at) %></dd></div>
</dl></section>
