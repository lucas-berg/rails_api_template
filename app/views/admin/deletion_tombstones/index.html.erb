<% content_for :title, 'Deletion ledger' %>
<header class="admin-heading"><div><span class="admin-eyebrow">Workspace operations</span><h1>Deletion ledger</h1><p>Review the record of irreversible deletion decisions.</p></div></header>
<%= search_form_for @search, url: admin_deletion_tombstones_path, html: { class: "admin-filters" } do |form| %>
  <div><%= form.label :subject_type_eq, "Subject type" %><%= form.select :subject_type_eq, %w[User Team], include_blank: "All" %></div>
  <div><%= form.label :subject_id_eq, "Subject id" %><%= form.number_field :subject_id_eq, min: 1 %></div>
  <div><%= label_tag :per_page, "Per page" %><%= select_tag :per_page, options_for_select([20, 50, 100], @per_page) %></div>
  <%= form.submit "Search", class: "admin-button" %><%= link_to "Clear", admin_deletion_tombstones_path, class: "admin-text-link" %>
<% end %>
<section class="admin-panel"><% if @deletion_tombstones.any? %><div class="admin-table-wrap"><table><caption class="admin-sr-only">Deletion ledger</caption><thead><tr><th scope="col">ID</th><th scope="col">Subject type</th><th scope="col">Subject id</th><th scope="col">Deleted at</th></tr></thead><tbody>
<% @deletion_tombstones.each do |record| %><tr><td><%= link_to record.id, admin_deletion_tombstone_path(record) %></td><td><%= record.subject_type.presence || "—" %></td><td><%= record.subject_id.presence || "—" %></td><td><%= admin_time(record.deleted_at) %></td></tr><% end %>
</tbody></table></div><% else %><div class="admin-empty"><h2>No matching records</h2><p>Try changing the filters or come back after new activity.</p></div><% end %></section>
<%= render "admin/shared/pagination", page: @page, per_page: @per_page, total: @total, filters: @filters %>
