<% content_for :title, 'API sessions' %>
<header class="admin-heading"><div><span class="admin-eyebrow">Workspace operations</span><h1>API sessions</h1><p>Inspect API session activity and revocation.</p></div></header>
<%= search_form_for @search, url: admin_auth_sessions_path, html: { class: "admin-filters" } do |form| %>
  <div><%= form.label :user_id_eq, "User id" %><%= form.number_field :user_id_eq, min: 1 %></div>
  <div><%= label_tag :per_page, "Per page" %><%= select_tag :per_page, options_for_select([20, 50, 100], @per_page) %></div>
  <%= form.submit "Search", class: "admin-button" %><%= link_to "Clear", admin_auth_sessions_path, class: "admin-text-link" %>
<% end %>
<section class="admin-panel"><% if @auth_sessions.any? %><div class="admin-table-wrap"><table><caption class="admin-sr-only">API sessions</caption><thead><tr><th scope="col">ID</th><th scope="col">User id</th><th scope="col">Expires at</th><th scope="col">Revoked at</th><th scope="col">Last used at</th></tr></thead><tbody>
<% @auth_sessions.each do |record| %><tr><td><%= link_to record.id, admin_auth_session_path(record) %></td><td><%= record.user_id.presence || "—" %></td><td><%= admin_time(record.expires_at) %></td><td><%= admin_time(record.revoked_at) %></td><td><%= admin_time(record.last_used_at) %></td></tr><% end %>
</tbody></table></div><% else %><div class="admin-empty"><h2>No matching records</h2><p>Try changing the filters or come back after new activity.</p></div><% end %></section>
<%= render "admin/shared/pagination", page: @page, per_page: @per_page, total: @total, filters: @filters %>
