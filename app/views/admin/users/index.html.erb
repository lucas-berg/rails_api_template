<% content_for :title, 'Accounts' %>
<header class="admin-heading"><div><span class="admin-eyebrow">Workspace operations</span><h1>Accounts</h1><p>Review account access and profile information.</p></div></header>
<%= search_form_for @search, url: admin_users_path, html: { class: "admin-filters" } do |form| %>
  <div><%= form.label :id_eq, "ID" %><%= form.number_field :id_eq, min: 1 %></div>
  <div><%= form.label :email_cont, "Email" %><%= form.search_field :email_cont, placeholder: "Contains email" %></div>
  <div><%= form.label :username_cont, "Username" %><%= form.search_field :username_cont, placeholder: "Contains username" %></div>
  <div><%= form.label :status_eq, "Status" %><%= form.select :status_eq, %w[active suspended], include_blank: "All" %></div>
  <div><%= label_tag :per_page, "Per page" %><%= select_tag :per_page, options_for_select([20, 50, 100], @per_page) %></div>
  <%= form.submit "Search", class: "admin-button" %><%= link_to "Clear", admin_users_path, class: "admin-text-link" %>
<% end %>
<section class="admin-panel"><% if @users.any? %><div class="admin-table-wrap"><table><caption class="admin-sr-only">Accounts</caption><thead><tr><th scope="col">ID</th><th scope="col">Email</th><th scope="col">Username</th><th scope="col">Status</th><th scope="col">Created at</th></tr></thead><tbody>
<% @users.each do |record| %><tr><td><%= link_to record.id, admin_user_path(record) %></td><td><%= record.email.presence || "—" %></td><td><%= record.username.presence || "—" %></td><td><%= admin_status(record.status) %></td><td><%= admin_time(record.created_at) %></td></tr><% end %>
</tbody></table></div><% else %><div class="admin-empty"><h2>No matching records</h2><p>Try changing the filters or come back after new activity.</p></div><% end %></section>
<%= render "admin/shared/pagination", page: @page, per_page: @per_page, total: @total, filters: @filters %>
