<% content_for :title, 'Notifications' %>
<header class="admin-heading"><div><span class="admin-eyebrow">Workspace operations</span><h1>Notifications</h1><p>Review notification metadata and read status.</p></div></header>
<%= search_form_for @search, url: admin_notifications_path, html: { class: "admin-filters" } do |form| %>
  <div><%= form.label :user_id_eq, "User id" %><%= form.number_field :user_id_eq, min: 1 %></div>
  <div><%= form.label :team_id_eq, "Team id" %><%= form.number_field :team_id_eq, min: 1 %></div>
  <div><%= form.label :kind_eq, "Kind" %><%= form.search_field :kind_eq, placeholder: "Exact kind" %></div>
  <div><%= form.label :category_eq, "Category" %><%= form.select :category_eq, %w[security activity], include_blank: "All" %></div>
  <div><%= label_tag :per_page, "Per page" %><%= select_tag :per_page, options_for_select([20, 50, 100], @per_page) %></div>
  <%= form.submit "Search", class: "admin-button" %><%= link_to "Clear", admin_notifications_path, class: "admin-text-link" %>
<% end %>
<section class="admin-panel"><% if @notifications.any? %><div class="admin-table-wrap"><table><caption class="admin-sr-only">Notifications</caption><thead><tr><th scope="col">ID</th><th scope="col">User id</th><th scope="col">Team id</th><th scope="col">Kind</th><th scope="col">Read at</th></tr></thead><tbody>
<% @notifications.each do |record| %><tr><td><%= link_to record.id, admin_notification_path(record) %></td><td><%= record.user_id.presence || "—" %></td><td><%= record.team_id.presence || "—" %></td><td><%= record.kind.presence || "—" %></td><td><%= admin_time(record.read_at) %></td></tr><% end %>
</tbody></table></div><% else %><div class="admin-empty"><h2>No matching records</h2><p>Try changing the filters or come back after new activity.</p></div><% end %></section>
<%= render "admin/shared/pagination", page: @page, per_page: @per_page, total: @total, filters: @filters %>
