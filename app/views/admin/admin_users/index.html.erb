<% content_for :title, 'Administrators' %>
<header class="admin-heading"><div><span class="admin-eyebrow">Workspace operations</span><h1>Administrators</h1><p>Review platform access and manage administrator accounts.</p></div><% if policy([:admin, AdminUser]).create? %><%= link_to 'New administrator', new_admin_admin_user_path, class: 'admin-button' %><% end %></header>
<%= search_form_for @search, url: admin_admin_users_path, html: { class: "admin-filters" } do |form| %>
  <div><%= form.label :email_cont, "Email" %><%= form.search_field :email_cont, placeholder: "Contains email" %></div>
  <div><%= form.label :role_eq, "Role" %><%= form.select :role_eq, %w[support super_admin], include_blank: "All" %></div>
  <div><%= label_tag :per_page, "Per page" %><%= select_tag :per_page, options_for_select([20, 50, 100], @per_page) %></div>
  <%= form.submit "Search", class: "admin-button" %><%= link_to "Clear", admin_admin_users_path, class: "admin-text-link" %>
<% end %>
<section class="admin-panel"><% if @admin_users.any? %><div class="admin-table-wrap"><table><caption class="admin-sr-only">Administrators</caption><thead><tr><th scope="col">ID</th><th scope="col">Email</th><th scope="col">Role</th><th scope="col">Sign in count</th><th scope="col">Current sign in at</th></tr></thead><tbody>
<% @admin_users.each do |record| %><tr><td><%= link_to record.id, admin_admin_user_path(record) %></td><td><%= record.email.presence || "—" %></td><td><%= admin_status(record.role) %></td><td><%= record.sign_in_count.presence || "—" %></td><td><%= admin_time(record.current_sign_in_at) %></td></tr><% end %>
</tbody></table></div><% else %><div class="admin-empty"><h2>No matching records</h2><p>Try changing the filters or come back after new activity.</p></div><% end %></section>
<%= render "admin/shared/pagination", page: @page, per_page: @per_page, total: @total, filters: @filters %>
