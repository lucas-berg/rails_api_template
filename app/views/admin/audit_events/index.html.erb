<% content_for :title, 'Audit history' %>
<header class="admin-heading"><div><span class="admin-eyebrow">Workspace operations</span><h1>Audit history</h1><p>Trace the actor, reason and outcome of operational changes.</p></div></header>
<%= search_form_for @search, url: admin_audit_events_path, html: { class: "admin-filters" } do |form| %>
  <div><%= form.label :team_id_eq, "Team id" %><%= form.number_field :team_id_eq, min: 1 %></div>
  <div><%= form.label :actor_type_eq, "Actor type" %><%= form.search_field :actor_type_eq, placeholder: "Exact actor type" %></div>
  <div><%= form.label :actor_id_eq, "Actor id" %><%= form.number_field :actor_id_eq, min: 1 %></div>
  <div><%= form.label :action_cont, "Action" %><%= form.search_field :action_cont, placeholder: "Contains action" %></div>
  <div><%= form.label :target_type_eq, "Target type" %><%= form.search_field :target_type_eq, placeholder: "Exact target type" %></div>
  <div><%= form.label :target_id_eq, "Target id" %><%= form.number_field :target_id_eq, min: 1 %></div>
  <div><%= form.label :occurred_at_gteq, "Since (UTC)" %><%= form.date_field :occurred_at_gteq %></div>
  <div><%= label_tag :per_page, "Per page" %><%= select_tag :per_page, options_for_select([20, 50, 100], @per_page) %></div>
  <%= form.submit "Search", class: "admin-button" %><%= link_to "Clear", admin_audit_events_path, class: "admin-text-link" %>
<% end %>
<section class="admin-panel"><% if @audit_events.any? %><div class="admin-table-wrap"><table><caption class="admin-sr-only">Audit history</caption><thead><tr><th scope="col">ID</th><th scope="col">Action</th><th scope="col">Actor type</th><th scope="col">Actor id</th><th scope="col">Team id</th><th scope="col">Occurred at</th></tr></thead><tbody>
<% @audit_events.each do |record| %><tr><td><%= link_to record.id, admin_audit_event_path(record) %></td><td><%= record.action.presence || "—" %></td><td><%= record.actor_type.presence || "—" %></td><td><%= record.actor_id.presence || "—" %></td><td><%= record.team_id.presence || "—" %></td><td><%= admin_time(record.occurred_at) %></td></tr><% end %>
</tbody></table></div><% else %><div class="admin-empty"><h2>No matching records</h2><p>Try changing the filters or come back after new activity.</p></div><% end %></section>
<%= render "admin/shared/pagination", page: @page, per_page: @per_page, total: @total, filters: @filters %>
