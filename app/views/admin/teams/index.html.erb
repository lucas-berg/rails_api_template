<% content_for :title, 'Teams' %>
<header class="admin-heading"><div><span class="admin-eyebrow">Workspace operations</span><h1>Teams</h1><p>Review team status, language and timezone.</p></div></header>
<%= search_form_for @search, url: admin_teams_path, html: { class: "admin-filters" } do |form| %>
  <div><%= form.label :id_eq, "ID" %><%= form.number_field :id_eq, min: 1 %></div>
  <div><%= form.label :name_cont, "Name" %><%= form.search_field :name_cont, placeholder: "Contains name" %></div>
  <div><%= form.label :status_eq, "Status" %><%= form.select :status_eq, %w[active suspended deleted], include_blank: "All" %></div>
  <div><%= label_tag :per_page, "Per page" %><%= select_tag :per_page, options_for_select([20, 50, 100], @per_page) %></div>
  <%= form.submit "Search", class: "admin-button" %><%= link_to "Clear", admin_teams_path, class: "admin-text-link" %>
<% end %>
<section class="admin-panel"><% if @teams.any? %><div class="admin-table-wrap"><table><caption class="admin-sr-only">Teams</caption><thead><tr><th scope="col">ID</th><th scope="col">Name</th><th scope="col">Status</th><th scope="col">Locale</th><th scope="col">Timezone</th></tr></thead><tbody>
<% @teams.each do |record| %><tr><td><%= link_to record.id, admin_team_path(record) %></td><td><%= record.name.presence || "—" %></td><td><%= admin_status(record.status) %></td><td><%= record.locale.presence || "—" %></td><td><%= record.timezone.presence || "—" %></td></tr><% end %>
</tbody></table></div><% else %><div class="admin-empty"><h2>No matching records</h2><p>Try changing the filters or come back after new activity.</p></div><% end %></section>
<%= render "admin/shared/pagination", page: @page, per_page: @per_page, total: @total, filters: @filters %>
